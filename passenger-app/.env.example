# SpotHail Passenger App Environment Configuration
# Standardized API URL for backend HTTP and WebSocket server (Next.js)
# Local fallback: http://localhost:4000
# Production: e.g. https://spothail-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# (Optional) Driver App URL for cross-navigation
# Local fallback: http://localhost:3001
# Production: e.g. https://spothail-driver.vercel.app
NEXT_PUBLIC_DRIVER_APP_URL=http://localhost:3001
