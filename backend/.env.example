# SpotHail Backend Environment Configuration
# Dynamic port (Render automatically provides process.env.PORT)
PORT=4000

# CORS Allowed Origins: comma-separated list of allowed origins or '*' to allow all
# Example for production: https://spothail-passenger.vercel.app,https://spothail-driver.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
